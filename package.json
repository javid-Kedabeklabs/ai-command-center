{
  "name": "ai-command-center",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "server/",
    "web/",
    "dist/",
    "scripts/",
    "tests/",
    "docs/",
    "*.md",
    "playwright.config.ts",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "npm run verify:release",
    "test:fast": "node scripts/checkpoint-state-tests.mjs && node scripts/run-control-tests.mjs && node scripts/subworkflow-receipt-tests.mjs && node scripts/redaction-tests.mjs && node scripts/trigger-store-tests.mjs",
    "test:backup": "node scripts/backup-restore-tests.mjs",
    "backup": "node scripts/backup.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "test:package": "node scripts/package-artifact-tests.mjs",
    "test:install": "node scripts/clean-package-install-tests.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "release:lifecycle": "node scripts/release-lifecycle.mjs",
    "test:release-lifecycle": "node scripts/release-lifecycle-tests.mjs",
    "service": "node scripts/product-launch-agent.mjs",
    "test:service": "node scripts/product-launch-agent-tests.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:browser": "playwright test",
    "test:browser:repeat": "playwright test --repeat-each=30",
    "start": "node server/index.js",
    "launch": "npm run build && node server/index.js",
    "prepack": "npm run build && npm run sbom"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "express": "^4.21.0",
    "marked": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
