{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "filesChanged", "tests", "risks", "recommendedAction"],
  "properties": {
    "status": { "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "FAILED_SAFELY"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "commitSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "filesChanged": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2000 } },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string", "maxLength": 1000 },
          "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
          "details": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "risks": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2000 } },
    "assumptions": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2000 } },
    "recommendedAction": { "enum": ["INTEGRATE", "REQUEST_CHANGES", "DISCARD", "NEEDS_HUMAN_DECISION"] }
  }
}
